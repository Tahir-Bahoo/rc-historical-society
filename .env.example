# Copy to `.env` and fill in real values for your environment.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=rchistoricalsociety.org,www.rchistoricalsociety.org

# Max upload size for admin PDF uploads (MB). Must match or stay below nginx limit.
DATA_UPLOAD_MAX_MB=100
FILE_UPLOAD_MAX_MB=10
NGINX_CLIENT_MAX_BODY_MB=100

# --- Database (set these in prod; leave blank in dev to use SQLite) ---
POSTGRES_DB=rchs
POSTGRES_USER=rchs
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Search service ---
# URL the Django app uses to reach the FastAPI service
SEARCH_SERVICE_URL=http://search:8001
SEARCH_SERVICE_TIMEOUT=5

# Database URL the FastAPI service uses (SQLAlchemy format).
# Leave blank to let it derive the URL from the POSTGRES_* vars above.
SEARCH_DATABASE_URL=

# CORS for the FastAPI service (comma-separated). Use "*" for everyone.
CORS_ORIGINS=https://rchistoricalsociety.org

# Where uploaded PDFs live on the public site (used to build links in search results)
MEDIA_URL=/media/
STATIC_URL=/static/
