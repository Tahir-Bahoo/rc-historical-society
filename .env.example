# Copy to `.env` and fill in real values for your environment.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Include domain(s) and the current EC2 public IP (IP changes after Stop/Start unless you use an Elastic IP)
DJANGO_ALLOWED_HOSTS=rchistoricalsociety.org,www.rchistoricalsociety.org,3.138.112.5

# Max upload size for admin PDF uploads (MB). Must match or stay below nginx limit.
DATA_UPLOAD_MAX_MB=400
FILE_UPLOAD_MAX_MB=10
NGINX_CLIENT_MAX_BODY_MB=400

# --- Database (set these in prod; leave blank in dev to use SQLite) ---
POSTGRES_DB=rchs
POSTGRES_USER=rchs
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Search service ---
# URL the Django app uses to reach the FastAPI service
SEARCH_SERVICE_URL=http://search:8001
SEARCH_SERVICE_TIMEOUT=5

# Database URL the FastAPI service uses (SQLAlchemy format).
# Leave blank to let it derive the URL from the POSTGRES_* vars above.
SEARCH_DATABASE_URL=

# CORS for the FastAPI service (comma-separated). Use "*" for everyone.
CORS_ORIGINS=https://rchistoricalsociety.org

# Where static assets and uploaded PDFs are served (local dev defaults)
MEDIA_URL=/media/
STATIC_URL=/static/

# --- S3 media (production EC2; leave DJANGO_USE_S3 unset on local dev) ---
# DJANGO_USE_S3=1
# AWS_STORAGE_BUCKET_NAME=rc-bucket-media
# AWS_S3_REGION_NAME=us-east-2
# AWS_LOCATION=media
# MEDIA_URL=https://rc-bucket-media.s3.us-east-2.amazonaws.com/media/
# Credentials: attach an IAM role to the EC2 instance (no keys in .env).
# Optional — only for local/dev testing against S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
